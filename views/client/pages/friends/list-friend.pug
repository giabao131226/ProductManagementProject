extends ../../layouts/default

block main
    link(rel = "stylesheet" href = "/css/client/friends.css")
    p(id-page = "list-friend")
    .container-fluid.text-align-start
        .container 
            .py-2
            include ../../partials/friendNavigate
            .py-2
            .d-flex.items-center.gap-x-3
                each item in users
                    .cardFriend.col-3.d-flex.items-center.gap-x-3.add(user-id = item._id)
                        .online(class = item.online ? "bg-online" : "bg-offline")
                        .vien
                            img(src = item.avatar)
                        .d-flex.flex-column.gap-y-1
                            span.font-bold.font-14 #{item.fullName}
                            button(btn-send-request-friend user-id = item._id).bg-blue.text-white.font-bold Kết Bạn
                            a(href = `/chat/${item.room_chat_id}`) 
                                button.bg-blue.text-white.font-bold.border-none Nhắn tin
                            button(btn-unfriend user-id = item._id).bg-blue.text-white.font-bold.border-none Huỷ Kết Bạn
    
    p.d-none(user_id = user._id) Hello

    script(src = "/socket.io/socket.io.js")
    script(src = "/js/friend.js")