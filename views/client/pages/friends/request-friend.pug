extends ../../layouts/default

block main
    link(rel = "stylesheet" href = "/css/client/friends.css")
    p(id-page = "request-friend")
    .container-fluid.text-align-start
        .container 
            .py-2
            include ../../partials/friendNavigate
            .py-2
            .d-flex.items-center.gap-x-3.listCardFriend
                each item in users
                    .cardFriend.col-3.d-flex.items-center.gap-x-3.add(user-id = item._id)
                        .vien
                            img(src = users.avatar)
                        .d-flex.flex-column.gap-y-1 
                            span.font-bold.font-14 #{item.fullName}
                            button(btn-send-request-friend user-id = item._id).bg-blue.text-white.font-bold Kết Bạn
                            button(btn-cancel-request-friend user-id = item._id).bg-gray.text-white.font-bold Huỷ
    p.d-none(user_id = user._id)
    script(src = "/socket.io/socket.io.js")
    script(src = "/js/friend.js")